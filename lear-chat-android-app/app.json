
{
  "expo": {
    "name": "LEAR Chat",
    "slug": "lear-chat",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "learchat",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/lear-chat-icon.png",
    "ios": {
      "bundleIdentifier": "org.learmesh.chat",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "LEAR Chat uses Bluetooth to connect to your nearby LEAR relay node.",
        "NSBluetoothPeripheralUsageDescription": "LEAR Chat uses Bluetooth to connect to your nearby LEAR relay node."
      }
    },
    "android": {
      "package": "org.learmesh.chat",
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/lear-chat-icon.png",
        "backgroundColor": "#06172B"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "neverForLocation": true,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "LEAR Chat uses Bluetooth to connect to your nearby LEAR relay node."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "9e9004c0-b11c-413c-8be6-9e36d29734d4"
      }
    },
    "owner": "vishvjeet123"
  }
}